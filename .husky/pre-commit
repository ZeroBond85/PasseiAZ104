# D5: SECRET → LINT(staged) → SIZE. VALIDATE entra em S2 (quando validate-questions existir).
staged=$(git diff --cached --name-only)
echo "$staged" | grep -qE '^\.env(\..*)?$' && { echo 'BLOQUEADO: .env* no stage'; exit 1; }
echo "$staged" | grep -qE 'sk-[A-Za-z0-9]{10,}|AIza[A-Za-z0-9_-]{10,}|ghp_[A-Za-z0-9]{10,}' && { echo 'BLOQUEADO: possível segredo no stage'; exit 1; }
echo "$staged" | grep -qE '\.(ts|js|mts|json|css)$' && npx lint-staged
for f in $(echo "$staged" | grep '^data/.*\.json$' || true); do
  [ -f "$f" ] && [ "$(wc -c < "$f")" -gt 204800 ] && { echo "BLOQUEADO: $f > 200KB (§9)"; exit 1; }
done
# Banco: valida Zod+FK+dedup ANTES do commit (~0.9s, dentro do teto de 10s do §9).
# Só dispara quando mexe no schema, no validador ou no próprio banco.
if echo "$staged" | grep -qE '^(data/.*\.json|src/engine/question-schema\.ts|scripts/validate-questions\.mts)$'; then
  npm run validate || { echo "BLOQUEADO: validate falhou (veja a saida acima)"; exit 1; }
fi
exit 0
